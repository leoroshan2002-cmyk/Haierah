{
  "version": 2,
  "routes": [
    { "handle": "filesystem" },
    {
      "src": "/api/(.*)",
      "dest": "https://haierah.onrender.com/api/$1"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "https://haierah.onrender.com/uploads/$1"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
